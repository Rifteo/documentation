{
  "$schema": "https://mintlify.com/docs.json",
  "name": "AuditGuard",
  "description": "The open community hub for AuditGuard skills, scripts, and compliance workflows.",
  "theme": "linden",
  "colors": {
    "primary": "#EEC12A",
    "light": "#EEC12A",
    "dark": "#EEC12A"
  },
  "logo": {
    "light": "/logos/black.png",
    "dark": "/logos/white.png"
  },
  "favicon": "/logos/favicon.png",
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "icons": {
    "library": "fontawesome"
  },
  "background": {
    "decoration": "grid"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@auditguard.fr"
      },
      {
        "label": "github",
        "href": "https://github.com/AuditGuard-Community",
        "icon": "github"
      }
    ]
  },
  "banner": {
    "content": "AuditGuard Community Hub is now live — [explore skills →](/skills/overview)",
    "dismissible": true,
    "type": "info"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Home",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "docs/introduction",
              "docs/quickstart"
            ]
          },
          {
            "group": "Skills",
            "pages": [
              "skills/overview",
              "skills/find-skills",
              "skills/compliance-gap-analyzer",
              "skills/control-lookup",
              "skills/finding-writer",
              "skills/idor-hunter",
              "skills/jwt-cracker",
              "skills/risk-assessor",
              "skills/skill-benchmark",
              "skills/check-exploit",
              "skills/nuclei-template-writer",
              "skills/remediation-planner",
              "skills/ssti-hunter",
              "skills/xss-hunter"
            ]
          },
          {
            "group": "Contexts",
            "pages": [
              "contexts/overview",
              "contexts/web-app-pentest",
              "contexts/api-security-review",
              "contexts/mobile-pentest",
              "contexts/cloud-audit"
            ]
          },
          {
            "group": "Scripts",
            "pages": [
              "scripts/overview",
              "scripts/script-template"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "usage/commands",
              "usage/configuration",
              "usage/examples"
            ]
          },
          {
            "group": "Community",
            "pages": [
              "docs/contributing",
              "docs/style-guide"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/AuditGuard-Community"
    }
  },
  "search": {
    "prompt": "Search or ask AuditGuard AI..."
  },
  "seo": {
    "indexHiddenPages": false
  },
  "metadata": {
    "og:site_name": "AuditGuard Community",
    "og:locale": "en_US"
  },
  "errors": {
    "404": {
      "redirect": true
    }
  },
  "redirects": [],
  "integrations": {}
}
