{
  "$schema": "https://mintlify.com/docs.json",
  "name": "AuditGuard",
  "description": "The open community hub for AuditGuard skills, scripts, and compliance workflows.",
  "theme": "aspen",
  "colors": {
    "primary": "#EEC12A",
    "light": "#EEC12A",
    "dark": "#EEC12A"
  },
  "logo": {
    "light": "/medias/images/black.png",
    "dark": "/medias/images/white.png",
    "href": "/"
  },
  "favicon": "/medias/images/favicon.png",
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "fonts": {
    "heading": {
      "family": "Space Mono",
      "weight": 700
    },
    "body": {
      "family": "Space Mono",
      "weight": 400
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "background": {
    "decoration": "grid"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "thumbnails": {
    "appearance": "dark"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@auditguard.fr"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/AuditGuard-Community",
        "icon": "github"
      }
    ]
  },
  "banner": {
    "content": "AuditGuard Community Hub is now live  [explore skills →](/skills/overview)",
    "dismissible": true
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Getting Started",
        "groups": [
          {
            "group": "Overview",
            "pages": ["docs/introduction", "docs/quickstart"]
          },
          {
            "group": "Community",
            "pages": ["docs/contributing", "docs/style-guide"]
          }
        ]
      },
      {
        "tab": "Skills",
        "groups": [
          {
            "group": "Overview",
            "pages": ["skills/overview", "skills/benchmarks"]
          },
          {
            "group": "Web Application",
            "pages": [
              "skills/xss-hunter",
              "skills/xxe-phantom",
              "skills/ssti-hunter",
              "skills/js-analyzer",
              "skills/hpp-hunter",
              "skills/clickjacking-hunter",
              "skills/redirect-forge"
            ]
          },
          {
            "group": "API Security",
            "pages": ["skills/idor-hunter", "skills/jwt-cracker"]
          },
          {
            "group": "Infrastructure",
            "pages": ["skills/ssrf-hunter", "skills/nuclei-template-writer", "skills/check-exploit"]
          },
          {
            "group": "Reconnaissance",
            "pages": ["skills/scope-grill", "skills/attack-surface", "skills/vuln-diagnose"]
          },
          {
            "group": "Reporting",
            "pages": [
              "skills/finding-writer",
              "skills/pentest-report",
              "skills/bugbounty-reporter",
              "skills/cvss-scorer",
              "skills/risk-assessor",
              "skills/remediation-planner"
            ]
          },
          {
            "group": "Compliance",
            "pages": ["skills/compliance-gap-analyzer", "skills/control-lookup"]
          },
          {
            "group": "Workflow",
            "pages": [
              "skills/find-skills",
              "skills/engagement-handoff",
              "skills/ctf-writeup",
              "skills/caveman",
              "skills/skill-benchmark"
            ]
          },
          {
            "group": "Integrations",
            "pages": ["skills/hexstrike-forge"]
          }
        ]
      },
      {
        "tab": "Contexts",
        "groups": [
          {
            "group": "Overview",
            "pages": ["contexts/overview"]
          },
          {
            "group": "Web & API",
            "pages": ["contexts/web-app-pentest"]
          },
          {
            "group": "Infrastructure",
            "pages": ["contexts/cloud-audit", "contexts/ad-pentest-unauthenticated"]
          },
          {
            "group": "Code Review",
            "pages": ["contexts/code-audit"]
          },
          {
            "group": "Bug Bounty",
            "pages": ["contexts/scope-to-bounty"]
          }
        ]
      },
      {
        "tab": "Scripts",
        "groups": [
          {
            "group": "Overview",
            "pages": ["scripts/overview", "scripts/script-template"]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Usage",
            "pages": ["usage/commands", "usage/configuration", "usage/examples"]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/AuditGuard-Community"
    },
    "links": [
      {
        "header": "Documentation",
        "items": [
          { "label": "Introduction", "href": "/docs/introduction" },
          { "label": "Quickstart", "href": "/docs/quickstart" },
          { "label": "Skills Overview", "href": "/skills/overview" }
        ]
      },
      {
        "header": "Resources",
        "items": [
          { "label": "Scripts", "href": "/scripts/overview" },
          { "label": "Contexts", "href": "/contexts/overview" },
          { "label": "Examples", "href": "/usage/examples" }
        ]
      },
      {
        "header": "Community",
        "items": [
          { "label": "Contributing", "href": "/docs/contributing" },
          { "label": "Style Guide", "href": "/docs/style-guide" },
          { "label": "Support", "href": "mailto:support@auditguard.fr" }
        ]
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "assistant"]
  },
  "interaction": {
    "drilldown": false
  },
  "search": {
    "prompt": "Search or ask AuditGuard AI..."
  },
  "seo": {
    "indexHiddenPages": false
  },
  "metadata": {
    "og:site_name": "AuditGuard Community",
    "og:locale": "en_US"
  },
  "errors": {
    "404": {
      "redirect": true,
      "title": "Page Not Found",
      "description": "The page you're looking for doesn't exist. Try searching or browse the [skills library](/skills/overview)."
    }
  },
  "redirects": [],
  "integrations": {}
}
