{
  "$schema": "https://mintlify.com/docs.json",
  "name": "AuditGuard",
  "description": "The open community hub for AuditGuard skills, scripts, and compliance workflows.",
  "theme": "linden",
  "colors": {
    "primary": "#EEC12A",
    "light": "#EEC12A",
    "dark": "#EEC12A"
  },
  "logo": {
    "light": "/logos/black.png",
    "dark": "/logos/white.png"
  },
  "favicon": "/logos/favicon.png",
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "icons": {
    "library": "fontawesome"
  },
  "background": {
    "decoration": "grid"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@auditguard.fr"
      },
      {
        "label": "github",
        "href": "https://github.com/AuditGuard-Community",
        "icon": "github"
      }
    ]
  },
  "banner": {
    "content": "AuditGuard Community Hub is now live — [explore skills →](/skills/overview)",
    "dismissible": true,
    "type": "info"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Home",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "docs/introduction",
              "docs/quickstart"
            ]
          },
          {
            "group": "Skills",
            "pages": [
              "skills/overview",
              {
                "group": "Planning",
                "pages": [
                  {
                    "group": "Reconnaissance",
                    "pages": [
                      "skills/scope-grill",
                      "skills/attack-surface"
                    ]
                  },
                  "skills/engagement-handoff"
                ]
              },
              {
                "group": "Discovery",
                "pages": [
                  "skills/find-skills",
                  "skills/js-analyzer",
                  "skills/check-exploit"
                ]
              },
              {
                "group": "Attack Skills",
                "pages": [
                  {
                    "group": "Injection",
                    "pages": [
                      "skills/ssrf-hunter",
                      "skills/xxe-phantom",
                      "skills/ssti-hunter"
                    ]
                  },
                  {
                    "group": "Client-Side",
                    "pages": [
                      "skills/xss-hunter",
                      "skills/clickjacking-hunter",
                      "skills/redirect-forge",
                      "skills/hpp-hunter"
                    ]
                  },
                  {
                    "group": "Auth & Access",
                    "pages": [
                      "skills/idor-hunter",
                      "skills/jwt-cracker"
                    ]
                  },
                  "skills/nuclei-template-writer"
                ]
              },
              {
                "group": "Compliance & Audit",
                "pages": [
                  "skills/compliance-gap-analyzer",
                  "skills/control-lookup"
                ]
              },
              {
                "group": "Scoring & Reporting",
                "pages": [
                  {
                    "group": "Scoring",
                    "pages": [
                      "skills/vuln-diagnose",
                      "skills/cvss-scorer",
                      "skills/risk-assessor"
                    ]
                  },
                  {
                    "group": "Reporting",
                    "pages": [
                      "skills/finding-writer",
                      "skills/bugbounty-reporter",
                      "skills/pentest-report",
                      "skills/remediation-planner"
                    ]
                  }
                ]
              },
              {
                "group": "Utilities",
                "pages": [
                  "skills/caveman",
                  "skills/ctf-writeup",
                  "skills/skill-benchmark"
                ]
              }
            ]
          },
          {
            "group": "Contexts",
            "pages": [
              "contexts/overview",
              {
                "group": "Web & API",
                "pages": [
                  "contexts/web-app-pentest",
                  "contexts/api-security-review"
                ]
              },
              "contexts/mobile-pentest",
              "contexts/cloud-audit"
            ]
          },
          {
            "group": "Scripts",
            "pages": [
              "scripts/overview",
              "scripts/script-template"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "usage/commands",
              "usage/configuration",
              "usage/examples"
            ]
          },
          {
            "group": "Community",
            "pages": [
              "docs/contributing",
              "docs/style-guide"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/AuditGuard-Community"
    }
  },
  "contextual": {
    "options": ["copy", "chatgpt", "claude"]
  },
  "search": {
    "prompt": "Search or ask AuditGuard AI..."
  },
  "seo": {
    "indexHiddenPages": false
  },
  "metadata": {
    "og:site_name": "AuditGuard Community",
    "og:locale": "en_US"
  },
  "errors": {
    "404": {
      "redirect": true
    }
  },
  "redirects": [],
  "integrations": {}
}
